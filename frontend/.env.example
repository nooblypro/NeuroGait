# NeuroGait Frontend Environment Configuration

# 1. Assessment Webpage URL (Where the Streamlit / Assessment UI is hosted)
# Development (default): /?view=assessment
# Production (Render Streamlit app): https://neurogait-app.onrender.com
VITE_ASSESSMENT_URL=

# 2. Backend Control Plane API URL (AWS API Gateway Endpoint)
# Production AWS API Gateway (default): https://xwncaenjbd.execute-api.ap-south-1.amazonaws.com
VITE_API_URL=https://xwncaenjbd.execute-api.ap-south-1.amazonaws.com
